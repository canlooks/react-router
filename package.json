{
  "name": "@canlooks/react-router",
  "version": "2.1.0",
  "author": "C.CanLiang <canlooks@gmail.com>",
  "description": "React router manager",
  "keywords": [
    "react",
    "router",
    "react-router"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canlooks/react-router"
  },
  "homepage": "https://github.com/canlooks/react-router",
  "bugs": {
    "url": "https://github.com/canlooks/react-router/issues",
    "email": "canlooks@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "npx shx rm -rf dist",
    "build:esm": "tsc -m esnext --outDir dist/esm && tsc-alias --outDir dist/esm && node scripts/write-esm-package.mjs",
    "build:cjs": "tsc -m commonjs --outDir dist/cjs",
    "build": "npm run build:esm && npm run build:cjs",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run -c test/vitest.config.mts",
    "test:coverage": "vitest run -c test/vitest.config.mts --coverage",
    "test:typecheck": "tsc -p test/tsconfig.json",
    "test:build": "npm run rebuild",
    "test:package": "npm run rebuild && node test/package-smoke.mjs && node test/tarball-consumer-smoke.mjs",
    "test:all": "npm run test:typecheck && npm run test:coverage && npm run test:package",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "test:browser:install": "playwright install firefox",
    "test:browser:serve": "vite -c test/browser/vite.config.mts --host=127.0.0.1 --port=4173",
    "test:node-matrix": "npm run rebuild && node test/node-matrix-smoke.mjs",
    "test:release": "npm run test:all && node test/node-matrix-smoke.mjs && npm run test:browser"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
